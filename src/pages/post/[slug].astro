---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AuthorList from '../../components/AuthorList.astro';
import CategoryLinks from '../../components/CategoryLinks.astro';
import TagList from '../../components/TagList.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { sortedEntries, featuredImage, formatDate, readingTime } from '../../lib/utils';

export async function getStaticPaths() {
  return (await sortedEntries('post')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary}>
  <PageHeader title={d.title} subtitle={d.subtitle} image={featuredImage('post', entry.id)} caption={d.image?.caption} placement={d.image?.placement ?? 1}>
    <div class="article-metadata">
      <div><AuthorList authors={d.authors} /></div>
      <span>Last updated on {formatDate(d.lastmod ?? d.date)}</span>
      <span class="middot-divider"></span>
      <span>{readingTime(entry.body)} min read</span>
      <CategoryLinks categories={d.categories} />
    </div>
    {d.projects?.length ? <div class="btn-links">{d.projects.map((p) => <a class="btn btn-page-header" href={`/project/${p.toLowerCase()}/`}>Project</a>)}</div> : null}
  </PageHeader>
  <div class="article-container">
    <div class="article-style"><Content /></div>
    <TagList tags={d.tags} />
    <AuthorCard authors={d.authors} />
  </div>
</Base>
